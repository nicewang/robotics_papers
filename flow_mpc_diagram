// FlowMPC Architecture
digraph {
	compound=true rankdir=LR splines=ortho
	node [fillcolor=white fontname=Helvetica shape=box style=filled]
	edge [fontname=Helvetica fontsize=10]
	subgraph cluster_inputs {
		color=grey label="System Inputs" style=dashed
		Env [label="Environment (SDF)
E" fillcolor="#e1f5fe" shape=ellipse]
		State [label="Start (x0), Goal (xG)
Cost Params (ρ)" fillcolor="#e1f5fe" shape=ellipse]
	}
	subgraph cluster_embedding {
		color=purple label="Projection
(Algorithm 3)
(OOD -> In-Distribution)" style=rounded
		Encoder [label="VAE Encoder
q_θ(h|E)" fillcolor="#fff9c4" shape=component]
		h [label="Latent h" fillcolor="#fff9c4" shape=ellipse]
		Prior [label="Prior Flow
p_φ(h), φ=θ
(OOD Check)" fillcolor="#ffe0b2" shape=component]
		Projector [label="Gradient Descent
min(L_OOD + L_flow)" fillcolor="#ffccbc" shape=diamond]
		h_hat [label="Projected Embedding
ĥ" fillcolor="#ffab91" shape=ellipse style="filled, bold"]
