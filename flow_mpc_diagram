	}
	subgraph cluster_flow {
		label="Generative Sampling" style=invis
		Noise [label="Gaussian Noise
Z ~ N(0, I)" fillcolor="#f3e5f5" shape=parallelogram]
		Flow [label="Conditional Flow
f_ζ(Z, C)" fillcolor="#e1bee7" shape=component]
