		h -> Prior
		h -> Projector
		Prior -> Projector [label="∇ L_OOD"]
		Projector -> h_hat [label="Updated h"]
	}
	subgraph cluster_context {
		label="Context Generation" style=invis
		CostNet [label="Cost Network
g_ω" fillcolor="#dcedc8" shape=component]
		Cost [label="Cost Vector
